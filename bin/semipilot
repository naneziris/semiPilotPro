#!/bin/sh
# Run semipilot straight from this checkout / download — no pip, no pipx, no venv.
# Needs python3 (>= 3.9) on PATH. Put this bin/ directory on your PATH, or call it by its full path / an alias.
# (Do not symlink this file elsewhere: it finds src/ relative to its own location.)
here=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
PYTHONPATH="$here/src${PYTHONPATH:+:$PYTHONPATH}" exec "${PYTHON:-python3}" -m semipilot "$@"
