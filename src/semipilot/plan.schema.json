{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PilotInLoop plan",
  "type": "object",
  "required": ["feature", "tasks"],
  "additionalProperties": false,
  "properties": {
    "feature": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "knowledge_updates": {
      "description": "Knowledge Updates Required — what @scribe must update after the human review (cards, instructions, ADR, dependencies, changelog). Rendered into implementation-plan.md.",
      "type": "array",
      "items": { "type": "string" }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "description", "depends_on", "expected_files", "acceptance_checks", "size"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^T[0-9]+$" },
          "title": { "type": "string", "minLength": 3 },
          "description": { "type": "string", "minLength": 10 },
          "depends_on": { "type": "array", "items": { "type": "string", "pattern": "^T[0-9]+$" } },
          "expected_files": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "acceptance_checks": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "size": { "type": "string", "enum": ["S", "M"] },
          "interfaces": {
            "description": "Public names/signatures this task creates or relies on. Written by the planner so the test-writer and dependent tasks share a contract.",
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
